# GitHub Roast - Backend Environment Variables
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: Personal Access Token for GitHub API (increases rate limit from 60 to 5,000 req/hr)
# Create a token with NO special scopes needed (public data only): https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: Google Gemini API Key for AI-generated roasts & compliments
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash
